# Pulse configuration. Copy to .env and edit: cp .env.example .env
# Every value below already works for local Docker Compose. .env is git-ignored.

# ---------------------------------------------------------------- Host ports
# Published on 127.0.0.1 only.
FRONTEND_PORT=3000
API_PORT=8000

# ---------------------------------------------------------------- Database
# Credentials for the bundled PostgreSQL container.
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
# Connection string used by api, worker, cron and init (SQLAlchemy + psycopg 3).
# Must match the credentials above when using the bundled container; point it
# at another PostgreSQL server to use that instead.
DATABASE_URL=postgresql+psycopg://pulse:pulse@postgres:5432/pulse

# ---------------------------------------------------------------- Queue (NATS JetStream)
NATS_URL=nats://nats:4222
NATS_STREAM=PULSE_DELIVERIES
NATS_SUBJECT=pulse.deliveries.email
NATS_CONSUMER=delivery-worker
NATS_CONNECT_TIMEOUT_SECONDS=3

# ---------------------------------------------------------------- Web ↔ API
# Base URL the browser uses to call the API.
#   /api                        -> same origin; the web dev server proxies it (recommended)
#   http://localhost:8000/api   -> call the API directly (add the web origin to CORS_ORIGINS)
VITE_API_BASE_URL=/api
# Where the web dev server forwards /api requests (resolved inside Docker).
API_PROXY_TARGET=http://api:8000
# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- Logging and display
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------- Worker and delivery simulation
# Defaults process ~100 recipients in about 40 seconds (excluding retries).
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_SECONDS=5
JOB_LEASE_SECONDS=30
SIM_DELAY_MIN_MS=600
SIM_DELAY_MAX_MS=1000
DELIVERY_MAX_ATTEMPTS=3
# Delay before attempt 2, attempt 3, ... (seconds)
RETRY_DELAYS_SECONDS=5,20

# ---------------------------------------------------------------- Cron dispatcher (per invocation)
CRON_CAMPAIGN_BATCH=20
CRON_OUTBOX_BATCH=500
CRON_MAX_SECONDS=45
OUTBOX_LEASE_SECONDS=30

# ---------------------------------------------------------------- Seed
# Minutes after first setup for the demo scheduled campaign.
DEMO_SCHEDULE_OFFSET_MINUTES=5
