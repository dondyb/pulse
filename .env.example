# Copy to .env to override defaults. Every value below already works locally.

# Host ports (bound to 127.0.0.1 only)
FRONTEND_PORT=3000
API_PORT=8000

# PostgreSQL (internal to the Compose network)
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse

# NATS JetStream (internal to the Compose network)
NATS_URL=nats://nats:4222

# Logging and display
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=Asia/Jakarta

# Worker and delivery simulation
# Defaults process ~100 recipients in about 40 seconds (excluding retries).
WORKER_CONCURRENCY=2
SIM_DELAY_MIN_MS=600
SIM_DELAY_MAX_MS=1000
DELIVERY_MAX_ATTEMPTS=3
# Delay before attempt 2, attempt 3, ... (seconds)
RETRY_DELAYS_SECONDS=5,20

# Cron dispatcher bounds per invocation
CRON_CAMPAIGN_BATCH=20
CRON_OUTBOX_BATCH=500
CRON_MAX_SECONDS=45

# Seed: minutes after first setup for the demo scheduled campaign
DEMO_SCHEDULE_OFFSET_MINUTES=5
